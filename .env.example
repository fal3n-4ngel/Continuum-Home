# Copy this file to .env.local and fill in your own values.
# Nothing here is required at build time — the app also accepts every one of
# these as a per-request header (X-Firebase-Config, X-Trakt-Client-Id, etc.),
# so you can skip this file entirely and self-host as a bring-your-own-config
# API. Setting them as env vars just makes YOUR deployment usable out of the box.

# ─── Firebase — server (required) ──────────────────────────────────────────
# Web App config object from Firebase Console → Project Settings → General,
# collapsed to a single-line JSON string. Used by API routes and cron jobs.
FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Service account JSON for the Firebase Admin SDK, also collapsed to one line.
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}

# Note: the browser Firebase Auth SDK does NOT need its own NEXT_PUBLIC_
# config. GET /api/auth/config derives the public subset (apiKey, authDomain,
# etc.) from FIREBASE_CONFIG above at request time and hands it to the client
# dynamically, so there's nothing extra to set here.

# ─── Auth & security ────────────────────────────────────────────────────────
# Symmetric key used to encrypt refresh tokens and other secrets at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# JSON array of OAuth clients allowed to complete /api/oauth/authorize and
# receive a user's Firebase refresh token. Without this, no client is
# permitted — the flow rejects everything rather than accepting any redirect.
# Entries are either an exact match or a prefix match (for platforms like
# ChatGPT Actions whose callback URL embeds a per-GPT id):
#   [{"clientId":"my-app","redirectUri":"https://my-app.example/callback"},
#    {"clientId":"chatgpt","redirectUriPrefix":"https://chatgpt.com/aip/"}]
OAUTH_ALLOWED_CLIENTS=

# ─── Redis cache (optional — reduces Firestore reads) ──────────────────────
# Free tier at https://upstash.com. Without these the app runs correctly,
# just with an in-memory-only cache that resets on every cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google Gemini (optional — powers the assistant chat & recommendations) ─
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Trakt (optional — enables movie/show sync) ────────────────────────────
# Create an app at https://trakt.tv/oauth/applications
# Redirect URI must be: https://<your-domain>/api/auth/trakt/callback
NEXT_PUBLIC_TRAKT_CLIENT_ID=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# ─── AniList (optional — enables anime sync) ───────────────────────────────
# Create an app at https://anilist.co/settings/developer
# Redirect URI must be: https://<your-domain>
NEXT_PUBLIC_ANILIST_CLIENT_ID=

# ─── OMDb (optional — powers watchlist/assistant IMDb lookups) ────────────
# Get a free key at https://www.omdbapi.com/apikey.aspx
# Despite the name this is an OMDb key, not an IMDb one — kept as-is for
# backward compatibility with existing deployments.
NEXT_PUBLIC_IMDB_API_KEY=

# ─── Central Monolith API — domain events (optional) ────────────────────────
# Defaults to https://monolith-postbacks.adithyakrishnan.com if unset. Server-only: this
# endpoint is authenticated, which is what stops anyone from fabricating an
# expense record by POSTing to a public URL. Unset means domain events are
# skipped entirely rather than sent unauthenticated.
MONOLITH_API_KEY=
# Base URL for server-to-server calls. Falls back to the default above.
MONOLITH_API_URL=
# Lets the browser bundle know which deployment it is, without depending on
# APP_ENV/VERCEL_ENV (neither is inlined client-side). Falls back to
# inferring from the hostname when unset.
NEXT_PUBLIC_APP_ENV=

# ─── Discord alerting (optional) ───────────────────────────────────────────
# Webhook URL for cron-failure alerts and admin broadcast notifications.
# Discord → Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=

# ─── Feature flags ──────────────────────────────────────────────────────────
# Production reads these through the Vercel Flags SDK (app/flags.ts), not
# from raw env vars — FLAGS_SECRET signs those evaluations for the Vercel
# Toolbar. Generate with: npx flags-sdk secret
FLAGS_SECRET=

# Local-dev-only override for the two flags above (GET /api/flags checks
# these only when NODE_ENV=development). Accepts "true"/"false"; unset
# defaults both to on. Has no effect in production.
ENABLE_INVESTMENT_PORTFOLIOS=
ENABLE_GEMINI_CHAT_ASSITANT=

# ─── Admin (optional) ───────────────────────────────────────────────────────
# Identity allowed into /admin and to receive admin-only emails. Falls back
# to the project owner's address if unset — set this if you self-host.
ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_EMAIL=

# ─── Google Analytics (optional) ───────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Per-deployment config (Production vs. UAT) ────────────────────────────
# Everything below varies between environments and is read through lib/env.ts.
# On Vercel, set these as environment variables scoped to each environment:
# Production for continuum-home, Preview (staging/qa branch) for UAT.
#
#   Variable                  Production                      UAT
#   ─────────────────────────────────────────────────────────────────────────
#   APP_URL                   continuum-home.vercel.app       uat-continuum-home.vercel.app
#   CRON_SECRET               unique                          DIFFERENT value
#   FIREBASE_*                personal-hub-adi                continuum-home-uat
#   UAT_TEST_EMAIL_OVERRIDE   (unset)                         your test inbox
#
# GET /api/cron/health reports the resolved environment plus any
# misconfiguration warnings, so a wrong setting is visible without guessing.

# Overrides environment detection. Normally unset — Vercel's VERCEL_ENV
# already resolves production, and Preview deployments resolve to "uat".
# One of: production | uat | development
APP_ENV=

# Public base URL of THIS deployment. Used to build unsubscribe links and the
# "Open Dashboard" buttons in emails, so UAT emails must not point at prod.
#   Production: https://continuum-home.vercel.app
#   UAT:        https://uat-continuum-home.vercel.app
# Falls back to VERCEL_URL, then localhost, when unset.
APP_URL=

# Shared secret the cron endpoints require in the Authorization header. Also
# signs unsubscribe-link tokens — give UAT its own value so a token minted on
# one deployment is never valid on the other.
CRON_SECRET=

# Bearer token that unlocks the E2E path in GET /api/cron/health. Leave unset
# outside CI — the health check skips that test rather than failing without it.
CRON_TEST_TOKEN=

# Resend API key + verified sender for outbound email.
RESEND_API_KEY=
CRON_SENDER_EMAIL=Continuum <onboarding@resend.dev>

# Flips every UAT_OVERRIDABLE var (FIREBASE_*, ENCRYPTION_KEY, UPSTASH_*,
# APP_URL) to its UAT_-prefixed counterpart and makes env.ENVIRONMENT report
# "uat". Normally set only in the UAT deployment's own environment, not here.
USE_UAT_CONFIG=

# ─── UAT / local safety net (set on UAT and in .env.local — NEVER on prod) ─
# When set, every cron and admin-broadcast email is redirected to this address
# instead of the real recipient, with the intended recipient tagged into the
# subject line.
#
# Set this in your own .env.local too. Local dev usually points at the
# PRODUCTION Firebase project, so manually hitting a cron endpoint (e.g.
# `curl -X POST localhost:3000/api/cron/expenses -H "Authorization: Bearer ..."`)
# will otherwise send real email to real users and mark them as already-sent
# for the day, causing the real scheduled run to skip them.
UAT_TEST_EMAIL_OVERRIDE=
